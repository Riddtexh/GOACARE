# GoaCare: send visitors from the project root to the client app.
# Place this file in the project root (the folder that contains "client" and "server").

DirectoryIndex client/index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Root URL (/) -> /client/index.html
  RewriteRule ^$ client/index.html [R=302,L]
</IfModule>

# Keep the server code, database and config files from being downloaded.
<IfModule mod_rewrite.c>
  RewriteRule ^server/ - [F,L]
  RewriteRule ^package\.json$ - [F,L]
</IfModule>
Options -Indexes
